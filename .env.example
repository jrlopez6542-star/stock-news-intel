# ============================================================
# Solo pega estas 2 keys (todo lo demás es opcional / default)
# Copia este archivo:  cp .env.example .env.local
# ============================================================

# 1) OpenAI — scoring + recomendación con IA
#    Sin key → heurística (gratis, sin llamadas a OpenAI)
#    Consigue key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo barato por defecto (centavos–pocos USD/mes con uso ligero)
OPENAI_MODEL=gpt-4o-mini

# 2) Benzinga — noticias reales preferidas (headline + teaser)
#    Sin key → Yahoo Finance RSS/search (gratis, sin key)
#    Solo si Yahoo también falla → mock etiquetado como demo
#    Basic free: https://www.benzinga.com/apis/
BENZINGA_API_KEY=
